% Sample Toy Agent Script
memory:
    keep result as whole;
    keep factor as whole;
end_memory

task entrypoint [] -> whole:
    result << 10;
    grab result;
    factor << 5;
    result << result times factor;
    show result;
    
    check result over 20 then
        show "Greater than 20";
    alt
        show "Less or equal 20";
    close;
done
