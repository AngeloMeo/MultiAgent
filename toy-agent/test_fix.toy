memory:
    keep choice as whole;
    keep num1 as fract;
    keep num2 as fract;
    keep result as fract;
    keep running as flag;
end_memory

task add [a as fract, b as fract] -> fract:
    yield a plus b;
done

task subtract [a as fract, b as fract] -> fract:
    yield a minus b;
done

task multiply [a as fract, b as fract] -> fract:
    yield a times b;
done

task divide [a as fract, b as fract] -> fract:
    % Gestione divisione per zero
    check b is 0 then
        show "Errore: Divisione per zero!";
        yield 0;
    close;
    yield a div b;
done

task show_menu [] -> whole:
    show "-------------------- ";
    show "Menu Calcolatrice";
    show "-------------------- ";
    show "1. Addizione";
    show "2. Sottrazione";
    show "3. Moltiplicazione";
    show "4. Divisione";
    show "5. Esci";
    show "-------------------- ";
    show "Inserisci la tua scelta:";
    grab choice;
    yield 1;
done

task entrypoint [] -> whole:
    running << yes;

    loop running is yes do
        show_menu run [];

        check choice is 1 then
            show "Inserisci il primo numero:";
            grab num1;
            show "Inserisci il secondo numero:";
            grab num2;
            result << add run [num1, num2];
            show "Risultato:";
            show result;
        alt_check choice is 2 then
            show "Inserisci il primo numero:";
            grab num1;
            show "Inserisci il secondo numero:";
            grab num2;
            result << subtract run [num1, num2];
            show "Risultato:";
            show result;
        alt_check choice is 3 then
            show "Inserisci il primo numero:";
            grab num1;
            show "Inserisci il secondo numero:";
            grab num2;
            result << multiply run [num1, num2];
            show "Risultato:";
            show result;
        alt_check choice is 4 then
            show "Inserisci il primo numero:";
            grab num1;
            show "Inserisci il secondo numero:";
            grab num2;
            result << divide run [num1, num2];
            check result is_not 0 then
               show "Risultato:";
               show result;
            close;
        alt_check choice is 5 then
            show "Arrivederci!";
            running << no;
        alt
            show "Scelta non valida. Riprova.";
        close;

    close;

    yield 0;
done
